{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Build the whole solution (used as the F5 pre-launch task).",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/LineCompanionBot.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "detail": "Run the xUnit test project.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/LineCompanionBot.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "setup-richmenu",
      "detail": "One-shot admin action: create and set the account-wide default rich menu (dotnet run -- setup).",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/LineCompanionBot/LineCompanionBot.csproj",
        "--",
        "setup"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "problemMatcher": []
    }
  ]
}
