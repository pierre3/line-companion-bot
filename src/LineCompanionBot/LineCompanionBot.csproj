<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables `dotnet user-secrets` as the local dev store for the LINE_* secrets. Bound into
         CompanionSettings by BuildCompanionConfiguration() in Program.cs (Development only). -->
    <UserSecretsId>line-companion-bot-9f3c2a41</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Line.OpenApi.Messaging" Version="1.0.0" />
    <PackageReference Include="Line.OpenApi.Messaging.Webhook" Version="1.0.0" />
    <PackageReference Include="Line.OpenApi.MiniApp" Version="1.0.0" />
  </ItemGroup>

</Project>
